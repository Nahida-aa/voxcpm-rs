# vox-lab 侧的 VoxCPM Burn 入口。独立 workspace 的原因见 ../Cargo.toml 顶部注释。
#
# 构建（首次约 7–10 分钟）：
#   just build-vulkan
#   just build-wgpu
#   just build-cpu

model_dir := "/home/aa/repos/env_ls/LocalDub/data/models/voxcpm2"

build-vulkan:
    cargo build --release -p vox-lab-burn --no-default-features --features vulkan --bin voxcpm-burn-vulkan

build-wgpu:
    cargo build --release -p vox-lab-burn --no-default-features --features wgpu --bin voxcpm-burn-wgpu

build-cpu:
    cargo build --release -p vox-lab-burn --no-default-features --features cpu --bin voxcpm-burn-cpu

# Vulkan bf16（需要 gfx 支持 bf16 matmul，gfx1103 上会 panic，见 ADR 0011）
run-vulkan text="你好。" steps="4":
    cargo run --release -p vox-lab-burn --no-default-features --features vulkan --bin voxcpm-burn-vulkan -- \
        --model-dir {{model_dir}} --timesteps {{steps}} "{{text}}" /tmp/burn-vk.wav

# wgpu f32：权重在 GPU 侧是 f32，4.4 GB 模型 → 约 8.7 GB 显存
run-wgpu text="你好。" steps="4":
    cargo run --release -p vox-lab-burn --no-default-features --features wgpu --bin voxcpm-burn-wgpu -- \
        --model-dir {{model_dir}} --timesteps {{steps}} "{{text}}" /tmp/burn-wgpu.wav
